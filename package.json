{
  "name": "nuxt",
  "type": "module",
  "private": true,
  "scripts": {
    "test": "vitest",
    "test:watch": "vitest watch",
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "lint": "cross-env NAPI_RS_FORCE_WASI=1 eslint .",
    "lint:fix": "cross-env NAPI_RS_FORCE_WASI=1 eslint . --fix",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "prepare": "husky",
    "typecheck": "nuxt typecheck",
    "gen-types": "supabase gen types typescript --local --schema public > app/types/database.types.ts && npm run gen-schemas",
    "gen-types-remote": "supabase gen types typescript --linked --schema public > app/types/database.types.ts && npm run gen-schemas",
    "gen-schemas": "supazod -i app/types/database.types.ts -o app/schemas/generated/database.schemas.ts -t app/schemas/generated/database.schemas.types.ts -s public && prettier --write app/schemas/generated",
    "db-reset": "supabase db reset & npm run gen-types"
  },
  "dependencies": {
    "@nuxtjs/supabase": "^2.0.10",
    "apexcharts": "^8.0.0",
    "nuxt": "^4.5.2",
    "vee-validate": "^4.15.1",
    "vue": "^3.5.42",
    "vue-router": "^5.3.1",
    "vue3-apexcharts": "^1.11.2",
    "vuetify-nuxt-module": "^1.0.0-rc.6",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@nuxt/eslint": "^1.17.0",
    "@nuxt/test-utils": "^4.3.2",
    "@vue/test-utils": "^2.5.1",
    "cross-env": "^10.1.0",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "happy-dom": "^20.14.5",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.9.6",
    "supazod": "^4.5.0",
    "typescript": "^6.0.3",
    "vitest": "^5.0.1",
    "vue-tsc": "^3.3.11",
    "vuetify": "^4.2.1"
  },
  "allowScripts": {
    "unrs-resolver@1.12.2": true,
    "esbuild@0.28.2": true
  }
}
